# Mẫu cấu hình HomeServer. Chép thành server/.env (git bỏ qua) hoặc chạy: python tools/make_secrets.py
# Không commit server/.env.

# WebSocket cho board (ADR 0007, 0008). Mặc định chỉ nghe máy này: Cloudflare Tunnel nối vào từ localhost.
# Muốn board vào thẳng trong mạng nhà (ws://IP:8765) thì đặt 0.0.0.0 và mở Windows Firewall.
BYTEOF_HOST=127.0.0.1
BYTEOF_PORT=8765
# Chuỗi ngẫu nhiên, phải giống BYTEOF_DEVICE_TOKEN trong firmware/include/secrets.h.
DEVICE_TOKEN=

# Brain: Muse qua muse2api chạy ở máy này (ADR 0006).
MUSE2API_BASE_URL=http://127.0.0.1:18610/v1
MUSE2API_KEY=
BRAIN_MODEL=muse-spark
